@page
@model LotteryApp.Pages.Lotto7x39Model
@{
    ViewData["Title"] = "Loto 7/39";
}

<div class="card card-lotto p-4 text-center">
    <h1>Loto 7/39</h1>
    <p class="text-muted">Vaša sretna kombinacija:</p>

    <div class="balls">
        @foreach (var (number, i) in Model.Numbers.Select((n, i) => (n, i)))
        {
            <div class="ball ball-green" style="--i:@i">@number</div>
        }
    </div>

    <div>
        <a class="btn btn-success btn-lg" asp-page="/Lotto7x39">Generiraj nove</a>
    </div>
</div>