@page
@model LotteryApp.Pages.Lotto7x39Model
@{
    ViewData["Title"] = "Loto 7/39";
}

<h1>Loto 7/39</h1>
<p>Vaši sretni brojevi:</p>

<div class="d-flex gap-2 mb-3">
    @foreach (var number in Model.Numbers)
    {
        <span class="badge rounded-pill bg-dark fs-4">@number</span>
    }
</div>

<a class="btn btn-secondary" asp-page="/Lotto7x39">Generiraj nove</a>