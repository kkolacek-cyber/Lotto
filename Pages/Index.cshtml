@page
@model IndexModel
@{
    ViewData["Title"] = "Početna";
}

<div class="hero">
    <h1 class="display-5">Loto Aplikacija</h1>
    <p class="lead text-muted">Generirajte svoju sretnu kombinaciju jednim klikom.</p>
</div>

<div class="row justify-content-center g-4">
    <div class="col-md-5">
        <div class="card card-lotto h-100 text-center p-4">
            <h3>Loto 6/45</h3>
            <p class="text-muted">6 brojeva u rasponu od 1 do 45.</p>
            <a class="btn btn-primary btn-lg mt-auto" asp-page="/Lotto6x45">Generiraj</a>
        </div>
    </div>
    <div class="col-md-5">
        <div class="card card-lotto h-100 text-center p-4">
            <h3>Loto 7/39</h3>
            <p class="text-muted">7 brojeva u rasponu od 1 do 39.</p>
            <a class="btn btn-success btn-lg mt-auto" asp-page="/Lotto7x39">Generiraj</a>
        </div>
    </div>
</div>